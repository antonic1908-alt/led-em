{
  "version": 1,
  "author": "Led_Embeded learning kit",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-c3-devkitm-1", "id": "esp", "top": 0, "left": 0, "attrs": { "serialInterface": "USB_SERIAL_JTAG" } },
    { "type": "board-ssd1306", "id": "oled", "top": -150, "left": 160, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": -160, "left": -150, "attrs": { "delayTime": "3" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 230, "left": -230, "attrs": { "lux": "10" } },
    { "type": "wokwi-hc-sr04", "id": "sonar", "top": -170, "left": 330, "attrs": { "distance": "200" } },
    { "type": "wokwi-pushbutton", "id": "btnUp", "top": 60, "left": 260, "attrs": { "color": "green", "label": "UP", "key": "1" } },
    { "type": "wokwi-pushbutton", "id": "btnDown", "top": 120, "left": 260, "attrs": { "color": "blue", "label": "DOWN", "key": "2" } },
    { "type": "wokwi-pushbutton", "id": "btnOk", "top": 180, "left": 260, "attrs": { "color": "yellow", "label": "OK", "key": "3" } },
    { "type": "wokwi-pushbutton", "id": "btnMan", "top": 240, "left": 260, "attrs": { "color": "red", "label": "MANUAL", "key": "4" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 150, "left": -150, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "strip", "top": 200, "left": -110, "attrs": { "color": "white", "label": "LED strip (via AO3400)" } }
  ],
  "connections": [
    [ "oled:VCC", "esp:3V3.1", "red", [] ],
    [ "oled:GND", "esp:GND.1", "black", [] ],
    [ "oled:SDA", "esp:6", "blue", [] ],
    [ "oled:SCL", "esp:7", "purple", [] ],

    [ "pir:VCC", "esp:5V.1", "red", [] ],
    [ "pir:GND", "esp:GND.2", "black", [] ],
    [ "pir:OUT", "esp:3", "orange", [] ],

    [ "ldr:VCC", "esp:3V3.2", "red", [] ],
    [ "ldr:GND", "esp:GND.3", "black", [] ],
    [ "ldr:AO", "esp:0", "green", [] ],

    [ "sonar:VCC", "esp:5V.2", "red", [] ],
    [ "sonar:GND", "esp:GND.6", "black", [] ],
    [ "sonar:TRIG", "esp:2", "cyan", [] ],
    [ "sonar:ECHO", "esp:RX", "magenta", [] ],

    [ "btnUp:1.l", "esp:4", "green", [] ],
    [ "btnUp:2.l", "esp:GND.7", "black", [] ],
    [ "btnDown:1.l", "esp:5", "blue", [] ],
    [ "btnDown:2.l", "esp:GND.7", "black", [] ],
    [ "btnOk:1.l", "esp:1", "gold", [] ],
    [ "btnOk:2.l", "esp:GND.8", "black", [] ],
    [ "btnMan:1.l", "esp:8", "red", [] ],
    [ "btnMan:2.l", "esp:GND.8", "black", [] ],

    [ "esp:10", "r1:1", "white", [] ],
    [ "r1:2", "strip:A", "white", [] ],
    [ "strip:C", "esp:GND.4", "black", [] ]
  ],
  "dependencies": {}
}
